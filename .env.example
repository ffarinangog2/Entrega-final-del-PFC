# Produccion/VM: SHA completo que identifica las seis imagenes aprobadas por CI.
IMAGE_TAG=<40-character-git-sha>
WEB_PORT=3000
API_GATEWAY_PORT=8080

# JWT compartido por auth-service y reservas-solicitudes-service.
# Debe ser Base64 valido y representar al menos 32 bytes. No versionar el valor real.
JWT_SECRET=
INTERNAL_API_KEY=

# Cifrado AES-256-GCM y hash de datos sensibles (usuarios-service).
# Deben ser Base64 valido, 32 bytes (256 bits). No versionar los valores reales.
DATA_ENCRYPTION_KEY=
DATA_HASH_KEY=

# Credenciales SQL independientes para cada microservicio.
# Use usuarios distintos y contrasenas aleatorias fuertes en .env.
AUTH_DB_USERNAME=
AUTH_DB_PASSWORD=
USUARIOS_DB_USERNAME=
USUARIOS_DB_PASSWORD=
ACADEMICO_DB_USERNAME=
ACADEMICO_DB_PASSWORD=
RESERVAS_DB_USERNAME=
RESERVAS_DB_PASSWORD=

# Clientes analíticos externos: incluya sslmode=verify-full y sslrootcert en las URLs.
RESERVAS_JDBC_URL=
RESERVAS_PANDAS_URL=

# Recuperación de contraseña. No versionar credenciales SMTP reales.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
PASSWORD_RESET_BASE_URL=http://localhost:3000/restablecer-contrasena
PASSWORD_RESET_EXPIRATION_MINUTES=20

# Observabilidad. Reemplace este ejemplo en la VM; no use una clave real aqui.
GF_SECURITY_ADMIN_PASSWORD=<strong-random-password>
# Bases de datos
# CockroachDB Entrega 3
CRDB_E3_IMAGE=cockroachdb/cockroach:v26.2.0

CRDB_E3_1_SQL_PORT=26261
CRDB_E3_1_HTTP_PORT=8092

CRDB_E3_2_SQL_PORT=26262
CRDB_E3_2_HTTP_PORT=8093

CRDB_E3_3_SQL_PORT=26263
CRDB_E3_3_HTTP_PORT=8094
